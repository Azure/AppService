---
import Base from '../../layouts/Base.astro';
---
<Base title="Search">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Search</span>
      <h1>Search the blog</h1>
    </div>
  </section>
  <section class="section search-page">
    <div class="container" style="max-width:52rem">
      <div id="search"></div>
      <noscript>Search requires JavaScript. Browse <a href="/posts/">all posts</a> instead.</noscript>
    </div>
  </section>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.PagefindUI) {
        document.getElementById('search').textContent = 'The search index is generated by "npm run build".';
        return;
      }
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    });
  </script>
</Base>
