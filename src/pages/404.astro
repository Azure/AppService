---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page</h1>
      <p class="lede">The post may have moved. Try searching, or browse the full archive.</p>
      <div class="chips">
        <a class="btn" href="/search/">Search posts</a>
        <a class="btn ghost" href="/posts/">All posts</a>
      </div>
    </div>
  </section>
</Base>
